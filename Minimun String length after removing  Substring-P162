class Solution {
    public int minLength(String s) {
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            sb.append(ch);

            int n = sb.length();

            if (n >= 2 &&
               ((sb.charAt(n - 2) == 'A' && sb.charAt(n - 1) == 'B') ||
                (sb.charAt(n - 2) == 'C' && sb.charAt(n - 1) == 'D'))) {

                sb.delete(n - 2, n); 
            }
        }

        return sb.length();
    }
}
