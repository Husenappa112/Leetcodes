class Solution {
    public int smallestIndex(int[] nums) {
        
        for(int i=0;i<nums.length;i++){
            int num=nums[i];
            int sum_digit=0;
         if(nums[i]<=9){
            if(nums[i]==i)
            return i;
            }
         while(num>0){
           sum_digit+=num%10;
           num/=10;
           
         }
          if(sum_digit==i){
            return i;
          }
        }
        
        return -1;
    }
}
