1614. Maximum Nesting Depth of the Parentheses

class Solution {
    public int maxDepth(String s) {
        int max_dep=0,curr_dep=0;
       
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
           if(ch=='('){
            curr_dep++;
            max_dep=Math.max(max_dep,curr_dep);
           }
           else if(ch==')')
           curr_dep--;
        }
        return max_dep;


        
    }
}
