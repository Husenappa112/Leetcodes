1021. Remove Outermost Parentheses

class Solution {
    public String removeOuterParentheses(String s) {
       int depth=0;
        StringBuilder curr=new StringBuilder();
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch=='('){
                if(depth > 0)
            curr.append(ch);
            depth++;
            }
        else{
            depth--;
            if(depth > 0){
                curr.append(ch);
            }
        }
        }
        return curr.toString();
    }
}
