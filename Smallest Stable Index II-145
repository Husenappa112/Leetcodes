
 Smallest Stable Index II
class Solution {
    public int firstStableIndex(int[] nums, int k) {
        if (nums == null || nums.length == 0) {
            return -1; 
        }
        
        int n = nums.length;
        
        int[] minFromRight = new int[n];
        minFromRight[n - 1] = nums[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            minFromRight[i] = Math.min(nums[i], minFromRight[i + 1]);
        }
      
        int maxFromLeft = nums[0];
        for (int i = 0; i < n; i++) {
           
            maxFromLeft = Math.max(maxFromLeft, nums[i]);
           
            int minRemaining = minFromRight[i]; 
            
            
            if (maxFromLeft - minRemaining <= k) {
                return i;
            }
        }
        
        return -1;
    }
}
